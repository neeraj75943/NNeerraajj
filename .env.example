# Frontend: leave blank for the same-origin API used locally and on Vercel.
# Set this only if the API is hosted on a different origin.
VITE_API_URL=

# Backend
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Comma-separated browser origins permitted to call the API. Vercel deployment
# URLs are allowed automatically; add your custom domain here when applicable.
CLIENT_ORIGIN=http://localhost:5173

# Optional SMTP notification. Leave these blank to save contact messages to
# MongoDB without sending an email notification.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password-or-app-password
MAIL_FROM=Portfolio Contact <no-reply@example.com>
NOTIFICATION_EMAIL=your-email@example.com
